# Bind to loopback for testing. For private play, use the host's private interface IP.
WFC_BIND_IP=127.0.0.1
WFC_HTTP_PORT=80

# The address of your separately deployed Poké Classic Framework GTS site,
# accessible from Docker. Use the origin only, without a path.
GTS_UPSTREAM=http://host.docker.internal:8081

# If the Docker host uses an HTTP proxy, list any additional private GTS host here.
WFC_NO_PROXY=
